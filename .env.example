# Copia este archivo a .env y completa los valores. NUNCA subas el .env al repositorio.

# Puerto donde escucha la API (Render define PORT automáticamente)
PORT=3000

# Orígenes permitidos por CORS, separados por coma (URL del frontend en Vercel y local)
CORS_ORIGINS=http://localhost:5173

# JSON COMPLETO de la cuenta de servicio de Firebase, en UNA sola línea.
# En Render se pega en la variable de entorno; en local, en tu .env.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Documento de Firestore que lee el endpoint de la base técnica
FIRESTORE_COLLECTION=health-data
FIRESTORE_DOCUMENT=main

# Tiempo máximo de espera a Firestore, en milisegundos
FIRESTORE_TIMEOUT_MS=5000
